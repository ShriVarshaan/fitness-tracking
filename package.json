{
  "name": "fitness-tracking",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @ft/web dev",
    "build": "pnpm --filter @ft/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @ft/db generate",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "sync:secrets": "node --experimental-strip-types scripts/set-sync-secrets.ts",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "db:local:reset": "supabase db reset --local"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "supabase": "^3.2.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "postgres": "^3.4.9"
  }
}
